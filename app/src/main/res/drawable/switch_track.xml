<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <gradient
                android:angle="0"
                android:endColor="@color/accent_violet"
                android:startColor="@color/accent" />
            <corners android:radius="100dp" />
            <size android:width="56dp" android:height="32dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#1FFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
            <corners android:radius="100dp" />
            <size android:width="56dp" android:height="32dp" />
        </shape>
    </item>
</selector>
