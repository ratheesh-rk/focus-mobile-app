<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/focus_bg</item>
        <item name="android:colorPrimaryDark">@color/focus_bg</item>
    </style>

    <style name="FocusTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/focus_bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/focus_bg</item>
        <item name="android:navigationBarColor">@color/focus_bg</item>
    </style>
</resources>
